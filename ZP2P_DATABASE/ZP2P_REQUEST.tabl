@EndUserText.label : 'P2P Purchase Request Header'
@AbapCatalog.enhancement.category : #NOT_EXTENSIBLE
@AbapCatalog.tableCategory : #TRANSPARENT
@AbapCatalog.deliveryClass : #A
@AbapCatalog.dataMaintenance : #RESTRICTED
define table zp2p_request {

  key client       : abap.clnt not null;
  key request_uuid : sysuuid_x16 not null;
  request_id       : abap.char(10) not null;
  requester_id     : abap.char(20) not null;
  department       : abap.char(30) not null;
  category         : abap.char(20) not null;
  description      : abap.char(100) not null;
  total_amount     : abap.dec(15,2) not null;
  currency         : abap.cuky not null;
  required_date    : abap.dats not null;
  justification    : abap.char(255) not null;
  status           : abap.char(20) not null;
  created_by       : abp_creation_user;
  created_at       : abp_creation_tstmpl;
  last_changed_by  : abp_locinst_lastchange_user;
  last_changed_at  : abp_locinst_lastchange_tstmpl;

}
