@EndUserText.label : 'P2P Purchase Request Items'
@AbapCatalog.enhancement.category : #NOT_EXTENSIBLE
@AbapCatalog.tableCategory : #TRANSPARENT
@AbapCatalog.deliveryClass : #A
@AbapCatalog.dataMaintenance : #RESTRICTED
define table zp2p_req_item {

  key client      : abap.clnt not null;
  key item_uuid   : sysuuid_x16 not null;
  request_uuid    : sysuuid_x16 not null;
  item_number     : abap.numc(5) not null;
  material_desc   : abap.char(100) not null;
  quantity        : abap.dec(13,3) not null;
  unit            : abap.char(3) not null;
  unit_price      : abap.dec(15,2) not null;
  item_total      : abap.dec(15,2) not null;
  currency        : abap.cuky not null;
  created_by      : abp_creation_user;
  created_at      : abp_creation_tstmpl;
  last_changed_by : abp_locinst_lastchange_user;
  last_changed_at : abp_locinst_lastchange_tstmpl;

}
